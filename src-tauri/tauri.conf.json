{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "服务器控制台",
  "version": "1.0.0",
  "identifier": "com.sshmcp.console",
  "mainBinaryName": "ssh-mcp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "服务器控制台",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ssh-mcp-stdio"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFOTZEN0Y1NDlDOUVGQTEKUldTaDc4bEo5ZGVXSHVEaDJPMlFCN2xrc1BGRmRsQ01Hc0FPdGR5QnE2aWVzbDZIUy9XSkVzVGMK",
      "endpoints": [
        "https://github.com/TH-Going/ssh-mcp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
